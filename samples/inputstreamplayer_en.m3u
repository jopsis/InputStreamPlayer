https://example.invalid/live/demo-channel/Manifest

#EXTINF:-1 tvg-id="demo-channel-catchup-append" group-title="Demo" catchup="append" catchup-days="7" catchup-source="?utc={utc}&utcend={utcend}",Demo Channel — DASH with catch-up (append mode)
#KODIPROP:inputstream.adaptive.manifest_type=mpd
https://example.invalid/live/demo-channel/manifest.mpd

